rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidLeaderboardEntry(data) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             data.displayName is string &&
             data.displayName.size() >= 1 &&
             data.displayName.size() <= 80 &&
             (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 1000)) &&
             data.highestWpm is int &&
             data.highestWpm >= 0 &&
             data.highestWpm <= 500 &&
             data.highestAccuracy is int &&
             data.highestAccuracy >= 0 &&
             data.highestAccuracy <= 100 &&
             data.language in ['bangla', 'english', 'mixed'] &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    match /leaderboard/{userId} {
      allow get, list: if isSignedIn();

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'displayName', 'highestWpm', 'highestAccuracy', 'language', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'displayName', 'photoUrl', 'highestWpm', 'highestAccuracy', 'language', 'updatedAt']) &&
                       isValidLeaderboardEntry(incoming());

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().userId == existing().userId &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoUrl', 'highestWpm', 'highestAccuracy', 'language', 'updatedAt']) &&
                       isValidLeaderboardEntry(incoming());

      allow delete: if isOwner(userId) && isValidId(userId);
    }

    match /users/{userId}/results/{resultId} {
      allow read, write: if isOwner(userId);
    }

    match /app_config/{configId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
  }
}
